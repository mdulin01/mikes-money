rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow only the owner (single-user app) to read/write everything.
    // ALLOWED_EMAILS on the client is the UX gate; these rules are the server gate.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'mdulin@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Main finance data doc and subcollections
    match /finances/{docId} {
      allow read, write: if isOwner();

      match /{sub=**} {
        allow read, write: if isOwner();
      }
    }

    // Plaid items (link metadata — access token stays server-side only)
    match /plaidItems/{itemId} {
      allow read: if isOwner();
      // Writes happen server-side from Cloud Functions using Admin SDK; deny client writes.
      allow write: if false;
    }

    // Ingested transactions (written by Cloud Functions via Admin SDK)
    match /transactions/{txnId} {
      allow read, update: if isOwner();   // allow categorization edits
      allow create, delete: if false;
    }

    // Accounts (balances, metadata — server-written)
    match /accounts/{accountId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Investment holdings (positions, securities — server-written)
    match /holdings/{holdingId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Liabilities (credit card APRs, mortgage terms, student loans — server-written)
    match /liabilities/{liabId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Net worth history (daily snapshots — server-written)
    match /netWorthHistory/{dateStr} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
